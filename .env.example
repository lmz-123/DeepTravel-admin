# Existing Travel MySQL connection. When both projects share a Docker network,
# replace the host with that MySQL service name.
DATABASE_URL=mysql+pymysql://jiandi:deeptravel_mysql_2026@host.docker.internal:3307/jiandi?charset=utf8mb4
ADMIN_TOKEN=DeepTravelAdmin2026
CLIENT_LOG_INGEST_TOKEN=DeepTravelClientLogs2026
CORS_ORIGINS=*
MAX_UPLOAD_MB=30
OBJECT_STORAGE_PROVIDER=oss
OSS_REGION=cn-shenzhen
OSS_ENDPOINT=
OSS_PUBLIC_BUCKET=jiandi-media
OSS_PRIVATE_BUCKET=jiandi-private
OSS_PUBLIC_BASE_URL=https://cdn.example.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SIGNED_URL_TTL_SECONDS=300
NARRATION_PROVIDER=minimax
MINIMAX_API_KEY=
MINIMAX_T2A_ENDPOINT=https://api.minimaxi.com/v1/t2a_v2
MINIMAX_T2A_MODEL=speech-2.8-hd
MINIMAX_VOICE_ID=Chinese (Mandarin)_Gentleman
MINIMAX_TIMEOUT_SECONDS=45
NARRATION_PREVIEW_TTL_HOURS=24
CLIENT_LOG_MAX_REQUEST_KB=128
CLIENT_LOG_MAX_BATCH=50
CLIENT_LOG_RETENTION_DAYS=7
CLIENT_LOG_MAX_ROWS=20000
CLIENT_LOG_CLEANUP_BATCH=1000
BACKEND_LOGS_ENABLED=true
DOCKER_SOCKET_HOST_PATH=/var/run/docker.sock
DOCKER_API_VERSION=v1.41
LOG_SOURCES=travel-api=deeptravel-api-1,admin-api=deeptravel-admin-admin-api-1
LOG_TAIL_LIMIT=300
LOG_LINE_MAX_CHARS=8000
LOG_CONTEXT_MAX_CHARS=1000
LOG_HEARTBEAT_SECONDS=12
LOG_CLIENT_POLL_SECONDS=1
LOG_STREAM_BATCH=200
LOG_MAX_STREAMS=6
