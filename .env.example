# 数据库（必填）：连接旅行后端的同一个 MySQL 数据库。
# CMS 在 Docker 中运行时，格式为：
# mysql+pymysql://<用户名>:<密码>@host.docker.internal:3307/<数据库名>?charset=utf8mb4
# CMS 直接在宿主机运行时，将主机改为 127.0.0.1；密码中的特殊字符需 URL 编码。
DATABASE_URL=

# 访问令牌（必填）：分别生成两个不同的随机值，例如 openssl rand -hex 32。
# CMS 连接设置填写 ADMIN_TOKEN；App 日志上报使用 CLIENT_LOG_INGEST_TOKEN。
ADMIN_TOKEN=
CLIENT_LOG_INGEST_TOKEN=

# 网页来源：本地可用以下默认值，部署后改为实际 CMS 网页来源，多个值用逗号分隔。
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=30

# OSS（必填）：与旅行后端填写同一套现有资源配置，勿更换已有媒体所在 Bucket。
OBJECT_STORAGE_PROVIDER=oss
OSS_REGION=
# 可选：留空时根据 OSS_REGION 自动推导公网 Endpoint。
OSS_ENDPOINT=
OSS_PUBLIC_BUCKET=
OSS_PRIVATE_BUCKET=
# 填写现有媒体 CDN / 公共访问域名，包含 https://。
OSS_PUBLIC_BASE_URL=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SIGNED_URL_TTL_SECONDS=300

# 语音生成（选配）：生成新音频时填写 MINIMAX_API_KEY，其余先保留默认值。
NARRATION_PROVIDER=minimax
MINIMAX_API_KEY=
MINIMAX_T2A_ENDPOINT=https://api.minimaxi.com/v1/t2a_v2
MINIMAX_T2A_MODEL=speech-2.8-hd
MINIMAX_VOICE_ID="Chinese (Mandarin)_Gentleman"
MINIMAX_TIMEOUT_SECONDS=45
NARRATION_PREVIEW_TTL_HOURS=24

# 客户端日志：保留默认值即可。
CLIENT_LOG_MAX_REQUEST_KB=128
CLIENT_LOG_MAX_BATCH=50
CLIENT_LOG_RETENTION_DAYS=7
CLIENT_LOG_MAX_ROWS=20000
CLIENT_LOG_CLEANUP_BATCH=1000

# 后端容器日志（选配）：不用此功能时，将 BACKEND_LOGS_ENABLED 设为 false。
BACKEND_LOGS_ENABLED=true
DOCKER_SOCKET_HOST_PATH=/var/run/docker.sock
DOCKER_API_VERSION=v1.41
# 以下容器名是示例，请用 docker ps --format '{{.Names}}' 核对实际名称。
LOG_SOURCES=travel-api=deeptravel-api-1,admin-api=deeptravel-admin-admin-api-1
LOG_TAIL_LIMIT=300
LOG_LINE_MAX_CHARS=8000
LOG_CONTEXT_MAX_CHARS=1000
LOG_HEARTBEAT_SECONDS=12
LOG_CLIENT_POLL_SECONDS=1
LOG_STREAM_BATCH=200
LOG_MAX_STREAMS=6
